<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets">
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <SourcePath>$(SourcePath)</SourcePath>
    <ExecutablePath>$(ExecutablePath)</ExecutablePath>
    <IncludePath>$(BOOSTDIR);$(ARPDIR)\WBFL\Include;$(ARPDIR)\WBFL\Include\$(Platform)\$(Configuration);$(ARPDIR)\WBFL\Include\$(Platform);$(IncludePath)</IncludePath>
    <LibraryPath>$(BOOSTDIR)\stage\lib;$(LibraryPath)</LibraryPath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Link>
      <AdditionalLibraryDirectories>$(ARPDIR)\WBFL\RegFreeCOM\$(PlatformName)\$(ConfigurationName)</AdditionalLibraryDirectories>
    </Link>
    <Midl>
      <!-- Every .idl in this solution transitively imports WBFLPrimitiveTypes.h (via WBFLTypes.idl).
           MIDL_PASS hides that header's C++-only regions (using-declarations, inline functions, a
           couple of typedefs MIDL can't parse) from MIDL's own parser while leaving them visible to
           normal C++ compiles. Defined here, once, so every project's Midl step picks it up. -->
      <PreprocessorDefinitions>MIDL_PASS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </Midl>
  </ItemDefinitionGroup>
  <ItemGroup />
</Project>
