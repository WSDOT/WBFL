// The fundamental WBFL type aliases (Float64, IndexType, IDType, etc.) live in
// WBFLPrimitiveTypes.h, a plain C++ header - that is the single source of truth.
// This import both registers those types with MIDL's own type system (required for
// correct marshalling wherever they're used as interface parameter types in this
// and other .idl files) and causes the generated header to #include the same file
// for real C++ compiles. WBFLTypes.vcxproj defines MIDL_PASS for its Midl build step
// so the header's #if !defined(MIDL_PASS) regions (using-declarations, inline
// functions, and a couple of typedefs MIDL can't parse) are hidden from MIDL's
// parser but remain visible to normal C++ compiles.
cpp_quote("// See WBFLPrimitiveTypes.h for the definitions imported below.")
import "WBFLPrimitiveTypes.h";
